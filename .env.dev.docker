# ============================================
# Variables de Entorno - Contenedor Docker MySQL
# ============================================
#
# Este archivo es usado exclusivamente por docker-compose.yml
# para configurar el contenedor de MySQL.
#
# NO debe subirse a Git (está en .gitignore via *.env)
# Copia este archivo desde .env.docker.example si no existe.
#

# Contraseña del usuario root de MySQL (solo para administración interna)
MYSQL_ROOT_PASSWORD=Root@2026!

# Base de datos que se crea automáticamente al iniciar el contenedor
MYSQL_DATABASE=pps_db

# Usuario de la aplicación (coincide con DB_USER del .env del proyecto)
MYSQL_USER=user_pps

# Contraseña del usuario de la aplicación (coincide con DB_PASSWORD del .env)
MYSQL_PASSWORD=User@2026!


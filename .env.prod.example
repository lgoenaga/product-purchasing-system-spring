# ============================================
# Variables de Entorno — PRODUCCIÓN (PLANTILLA)
# ============================================
#
# Copiar este archivo como .env.prod en el servidor y completar
# con los valores reales antes de desplegar:
#
#   cp .env.prod.example .env.prod
#   nano .env.prod
#
# IMPORTANTE:
#   - .env.prod NUNCA se sube a Git (está en .gitignore)
#   - Este archivo (.env.prod.example) SÍ se versiona en Git
# ============================================

# ============================================
# Base de Datos MySQL
# ============================================
# DB_HOST debe ser el nombre del contenedor MySQL en la misma red Docker
DB_HOST=mysql-db
DB_PORT=3306
DB_NAME=wisegrade
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# ============================================
# Hibernate / JPA
# ============================================
# Producción: siempre none (nunca modificar schema automáticamente)
DB_DDL_AUTO=none
DB_SHOW_SQL=false
DB_POOL_SIZE=10

# ============================================
# Aplicación
# ============================================
SERVER_PORT=8080
APP_ENVIRONMENT=production

# ============================================
# CORS
# ============================================
# Dominio público que sirve nginx al browser.
# Ejemplos:
#   https://wisegrade.com
#   https://app.wisegrade.com
#   https://www.mi-tienda.com
# Si hay múltiples orígenes, separar con comas (sin espacios):
#   https://wisegrade.com,https://www.wisegrade.com
CORS_ALLOWED_ORIGINS=https://tu-dominio.com

# ============================================
# Logging
# ============================================
# Producción: INFO o WARN (nunca DEBUG ni TRACE)
LOG_LEVEL=INFO
LOG_SQL_LEVEL=WARN
LOG_SQL_BIND_LEVEL=OFF


# ============================================
# Variables para test local de imagen Docker
# ============================================
# Apunta al MySQL local de desarrollo (pps-mysql)
# Puerto 3307 porque está mapeado así en docker-compose.dev.yml
# ============================================

DB_HOST=localhost
DB_PORT=3307
DB_NAME=pps_db
DB_USER=user_pps
DB_PASSWORD=User@2026!

DB_DDL_AUTO=none
DB_SHOW_SQL=true
DB_POOL_SIZE=5

SERVER_PORT=8080
APP_ENVIRONMENT=development

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

LOG_LEVEL=INFO
LOG_SQL_LEVEL=DEBUG
LOG_SQL_BIND_LEVEL=OFF

